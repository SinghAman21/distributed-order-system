{
  "name": "mini-order-system",
  "version": "1.0.0",
  "description": "A simple order tracking system built with Node.js, Express, and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:be": "node src/server.js",

    "dev:be": "node --watch src/server.js",

    "init-db": "node src/db.js",
    "seed-db": "node src/seed.js",
    "worker:payment": "node src/payment-worker.js",
    "worker:inventory": "node src/inventory-worker.js",
    "worker:notification": "node src/notification-worker.js",
    "worker": "node src/payment-worker.js",
    "worker:outbox": "node src/outbox-publisher.js"
  },
  "keywords": [
    "orders",
    "express",
    "postgresql",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "@kubernetes/client-node": "^1.3.0",
    "kafkajs": "^2.2.4",
    "ws": "^8.18.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
